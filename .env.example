# LLM Providers (Pick at least one, or leave blank to test with local fallback)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

OPENAI_API_KEY=your_openai_api_key_here

# Azure AI Foundry & Azure OpenAI (Optional)
PROJECT_CONNECTION_STRING=eastus.api.azureml.ms;00000000-0000-0000-0000-000000000000;rg-university-faq;university-faq
MODEL_DEPLOYMENT_NAME=gpt-4o-mini
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_key
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# Azure AI Search (Optional for cloud index)
AI_SEARCH_CONNECTION_ID=university-search-conn-id
AI_SEARCH_INDEX_NAME=university-knowledge-index

# Azure Content Safety (Optional)
CONTENT_SAFETY_ENDPOINT=https://your-contentsafety.cognitiveservices.azure.com/
CONTENT_SAFETY_KEY=your-key-here
